{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easy-second-chat-v2",
  "main": "src_index.js",
  "compatibility_date": "2026-09-18",
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_ROOM", "class_name": "ChatRoom" }
    ]
  },
  "exports": {
    "ChatRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
